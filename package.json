{
  "name": "yegecali-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:cv": "node scripts/generate-cv.mjs",
    "prebuild": "npm run generate:cv",
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build && npm run prerender",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prerender": "vite build --ssr build/prerender.tsx --outDir .prerender && node .prerender/prerender.js"
  },
  "dependencies": {
    "@react-spring/web": "^10.1.2",
    "aos": "^2.3.4",
    "particles.js": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/aos": "^3.0.8",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "pdfkit": "^0.20.2",
    "prettier": "^3.9.10",
    "sass": "^1.107.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.0.0"
  }
}
